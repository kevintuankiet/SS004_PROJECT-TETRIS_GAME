// KHU VỰC CODE CỦA HƯNG (Khởi tạo, Sinh khối, Va chạm)
// =====================================================================
void initBoard() {
    // TODO: Khởi tạo bảng ban đầu
    for (int i = 0 ; i < H ; i++)
        for (int j = 0 ; j < W ; j++)
            if (i == 0 || i == H-1 || j ==0 || j == W-1) board[i][j] = '#';
            else board[i][j] = ' ';
    isGameOver = false;
}

void spawnBlock() {
    // TODO: Sinh khối ngẫu nhiên
    static bool seeded = false;
    if (!seeded) {
        srand(time(0));
        seeded = true;
    }
    
    // Xác định khối hiện tại
    if (nextBlockIndex == -1) 
        b = rand() % 7;
    else 
        b = nextBlockIndex;
    
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            currentBlock[i][j] = BASE_BLOCKS[b][i][j];
        }
    }
    // Đặt khối ở phía trên, giữa bảng
    x = (W - 4) / 2;
    y = 1;
    
    // Kiểm tra vị trí
    if (!canMove(0, 0, currentBlock)) {
        isGameOver = true;
    }
    
    // Sinh khối tiếp theo
    nextBlockIndex = rand() % 7;
}

bool canMove(int dx, int dy, const char shape[4][4]) {
    // TODO: Kiểm tra vị trí xuất phát có hợp lệ không & Có va chạm với biên/khối khác không?
    for (int i = 0; i < 4; i++ )
        for (int j = 0; j < 4; j++ )
            if (shape[i][j] != ' ') {
                int xt = x + j + dx;
                int yt = y + i + dy;

                // Kiểm tra va chạm 
                if (xt < 1 || xt >= W - 1 ||
                    yt < 1 || yt >= H - 1) {
                    return false;
                }
                if (board[yt][xt] != ' ') {
                    return false;
                }
            }
            
    return true;
}

void drawNextBlock() {
    if (nextBlockIndex < 0) return;

    cout << "\nNEXT BLOCK:\n";
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            cout << BASE_BLOCKS[nextBlockIndex][i][j];
        }
        cout << endl;
    }
}

// =====================================================================
// KHU VỰC CODE CỦA HUÂN (Điều khiển: Di chuyển, Xoay, Chạm đáy)
// =====================================================================
void getRotatedShape(char nextShape[4][4]) {
    // TODO: Tính hình dạng dự kiến
    if (b == 1)  return;
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4; j++)
            nextShape[j][3 - i] = currentBlock[i][j];
    if (!canMove(0, 0, nextShape))   return;
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4; j++)
            currentBlock[i][j] = nextShape[i][j];
    return;
}

void hardDrop() {
    // TODO: Dịch chuyển xuống vị trí thấp nhất
    while (1)
    {
        if (!canMove(0, 1, currentBlock))
            return;
        ++y;
    }
}

bool handlePlayerInput() {
    // TODO: Player có nhấn phím không? -> Di chuyển hay Xoay hay Chạm đáy? Cập nhật hình dạng mới, tọa độ mới.
    if (!kbhit())    return false;
    int key = getch();
    if(key == 224 || key == -32)
    {   
        key = getch();
        switch (key)
        {
            //move left
            case 75:    //left arrow
                if (canMove(-1, 0, currentBlock)) --x;
                break;
            //move right
            case 77:    //right arrow
                if (canMove(1, 0, currentBlock)) ++x;
                break;
            //move down
            case 80:    //down arrow
                if (canMove(0, 1, currentBlock)) ++y;
                break;
            //rotate block
            case 72:    //up arrow
            {
                char nextShape[4][4];
                getRotatedShape(nextShape);
                break;
            }
            default:
                return false;
        }
        return true;
    }
    else
    {
        switch(key)
        {
            //move left
            case 'a':
            case 'A':
                if (canMove(-1, 0, currentBlock)) --x;
                break;
            //move right
            case 'd':
            case 'D':
                if (canMove(1, 0, currentBlock)) ++x;
                break;
            //move down
            case 's':
            case 'S':
                if (canMove(0, 1, currentBlock)) ++y;
                break;
            //rotate block
            case 'w':
            case 'W':
            {
                char nextShape[4][4];
                getRotatedShape(nextShape);
                break;
            }
            //hard drop
            case 32:    //space
                hardDrop();
                hardDropRequested = true;
                break;
            //exit game
            case 'q':   
            case 'Q':
                isGameOver = true;
                break;
            default: 
                return false;
        }
        return true;
    }
}

// =====================================================================
// KHU VUC CODE CUA KHANG (Co dinh khoi, Xoa hang day & Tinh diem Combo)
// =====================================================================
void block2Board() {
    // Co dinh khoi hien tai (currentBlock) vao ma tran board
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            if (currentBlock[i][j] != ' ') {
                if (y + i >= 1 && y + i < H - 1 && x + j >= 1 && x + j < W - 1) {
                    board[y + i][x + j] = currentBlock[i][j];
                }
            }
        }
    }
}

void boardDelBlock() {
    // Xoa khoi tam khoi bang truoc khi cap nhat toa do moi
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            if (currentBlock[i][j] != ' ') {
                if (y + i >= 1 && y + i < H - 1 && x + j >= 1 && x + j < W - 1) {
                    board[y + i][x + j] = ' ';
                }
            }
        }
    }
}

void removeLine() {
    int linesCleared = 0; // Dem so hang xoa duoc trong 1 luot roi

    // Quet tu day len dinh vung choi (bo qua tuong day H-1 va tuong noc 0)
    for (int i = H - 2; i >= 1; i--) {
        bool isFull = true;
        
        for (int j = 1; j < W - 1; j++) {
            if (board[i][j] == ' ') {
                isFull = false;
                break;
            }
        }

        if (isFull) {
            linesCleared++;

            // Don cac hang phia tren xuong
            for (int ii = i; ii > 1; ii--) {
                for (int jj = 1; jj < W - 1; jj++) {
                    board[ii][jj] = board[ii - 1][jj];
                }
            }
            
            // Lam trong hang 1 de khong keo tuong noc (hang 0) xuong
            for (int jj = 1; jj < W - 1; jj++) {
                board[1][jj] = ' ';
            }

            i++; // Kiem tra lai hang i vua don xuong (truong hop an nhieu hang)
            draw();
            Sleep(200);
        }
    }

    // --- TINH DIEM CO BAN & HE SO NHAN COMBO ---
    if (linesCleared > 0) {
        // 1. Tinh diem co ban theo so hang xoa cung luc
        int basePoints = 0;
        if (linesCleared == 1) basePoints = 100;
        else if (linesCleared == 2) basePoints = 300;
        else if (linesCleared == 3) basePoints = 500;
        else if (linesCleared >= 4) basePoints = 800;

        // 2. Tang chuoi combo va tinh he so nhan (1.0x, 1.5x, 2.0x, 2.5x, toi da 3.0x)
        comboCount++;
        double comboMultiplier = 1.0 + (comboCount * 0.5);
        if (comboMultiplier > 3.0) comboMultiplier = 3.0;

        // Cong diem da nhan he so vao tong diem
        score += (int)(basePoints * comboMultiplier);
    } else {
        // Khong an duoc hang nao -> Reset chuoi combo
        comboCount = -1;
    }
}
