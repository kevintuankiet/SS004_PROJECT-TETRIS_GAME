#define H 20
#define W 15

// --- BIẾN TOÀN CỤC DÙNG CHUNG ---
char board[H][W] = {};              // Mảng lưu trạng thái bảng ('#' là tường, ' ' là trống, chữ cái là khối)
int b;                              // Chỉ số loại khối hiện tại (0 -> 6 tương ứng I, O, T, S, Z, J, L)
int nextBlockIndex = -1;            // Chỉ số khối sẽ xuất hiện tiếp theo
int x, y;                           // Tọa độ (cột x, hàng y) góc trên-trái của khối 4x4 đang rơi
char currentBlock[4][4];            // Ma trận 4x4 lưu hình dạng hiện tại của khối đang rơi (hỗ trợ xoay)
bool isGameOver = false;            // Trạng thái kết thúc trò chơi
int score = 0; // Diem so cua nguoi choi
int comboCount = -1;
bool hardDropRequested = false;

const char BASE_BLOCKS[7][4][4] = {
    {{' ','I',' ',' '}, {' ','I',' ',' '}, {' ','I',' ',' '}, {' ','I',' ',' '}}, // Khối I
    {{' ',' ',' ',' '}, {' ','O','O',' '}, {' ','O','O',' '}, {' ',' ',' ',' '}}, // Khối O
    {{' ',' ',' ',' '}, {' ','T',' ',' '}, {'T','T','T',' '}, {' ',' ',' ',' '}}, // Khối T
    {{' ',' ',' ',' '}, {' ','S','S',' '}, {'S','S',' ',' '}, {' ',' ',' ',' '}}, // Khối S
    {{' ',' ',' ',' '}, {'Z','Z',' ',' '}, {' ','Z','Z',' '}, {' ',' ',' ',' '}}, // Khối Z
    {{' ',' ',' ',' '}, {'J',' ',' ',' '}, {'J','J','J',' '}, {' ',' ',' ',' '}}, // Khối J
    {{' ',' ',' ',' '}, {' ',' ','L',' '}, {'L','L','L',' '}, {' ',' ',' ',' '}}  // Khối L
};

