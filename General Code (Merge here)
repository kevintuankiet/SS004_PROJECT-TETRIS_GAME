// =====================================================================
// KHU VỰC CODE CỦA KIỆT (Game Loop & Main Flow)
// =====================================================================
void runGameLoop() {
    // TODO: Xử lý toàn bộ luồng hàm con (Game Loop). 

    const DWORD FALL_INTERVAL = 500; // Thời gian tự động rơi: 500ms

    // Sinh khối đầu tiên
    spawnBlock();

    if (isGameOver) {
        drawGameOver();
        return;
    }

    // Đưa khối đầu tiên lên board để hiển thị
    block2Board();
    draw();

    DWORD lastFallTime = GetTickCount();

    // Vòng lặp chính của trò chơi
    while (!isGameOver) {

        // Bước 1: Xóa khối đang rơi khỏi board
        boardDelBlock();

        // Bước 2: Nhận thao tác người chơi
        hardDropRequested = false;
        handlePlayerInput();

        if (isGameOver) {
            break;
        }

        bool lockBlock = false;

        // Bước 3: Kiểm tra yêu cầu Hard Drop
        if (hardDropRequested) {
            lockBlock = true;
        }
        else {
            // Bước 4: Kiểm tra thời gian tự động rơi
            DWORD currentTime = GetTickCount();

            if (currentTime - lastFallTime >= FALL_INTERVAL) {

                if (canMove(0, 1, currentBlock)) {
                    ++y;
                }
                else {
                    lockBlock = true;
                }

                lastFallTime = currentTime;
            }
        }

        // Bước 5: Xử lý khi khối cần cố định
        if (lockBlock) {

            // Cố định khối vào board
            block2Board();

            // Xóa hàng đầy và cập nhật điểm
            removeLine();

            // Sinh khối tiếp theo
            spawnBlock();

            // Reset thời gian rơi cho khối mới
            lastFallTime = GetTickCount();

            if (isGameOver) {
                break;
            }
        }

        // Bước 6: Cập nhật trạng thái board
        block2Board();

        // Bước 7: Hiển thị màn hình
        draw();

        // Giảm tải CPU
        Sleep(10);
    }

    // Khi trò chơi kết thúc
    drawGameOver();
}

