void initBoard() {
    // TODO: Khởi tạo bảng ban đầu
    for (int i = 0 ; i < H ; i++)
        for (int j = 0 ; j < W ; j++)
            if (i == 0 || i == H-1 || j ==0 || j == W-1) board[i][j] = '#';
            else board[i][j] = ' ';
    isGameOver = false;
}

void spawnBlock() {
    // TODO: Sinh khối ngẫu nhiên
    static bool seeded = false;
    if (!seeded) {
        srand(time(0));
        seeded = true;
    }

    b = rand() % 7;
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            currentBlock[i][j] = BASE_BLOCKS[b][i][j];
        }
    }
    // Đặt khối ở phía trên, giữa bảng
    x = (W - 4) / 2;
    y = 1;
    
    // Kiểm tra vị trí
    if (!canMove(0, 0, currentBlock)) {
        isGameOver = true;
    }
}

bool canMove(int dx, int dy, const char shape[4][4]) {
    // TODO: Kiểm tra vị trí xuất phát có hợp lệ không & Có va chạm với biên/khối khác không?
    for (int i = 0; i < 4; i++ )
        for (int j = 0; j < 4; j++ )
            if (shape[i][j] != ' ') {
                int xt = x + j + dx;
                int yt = y + i + dy;

                // Kiểm tra va chạm 
                if (xt < 1 || xt >= W - 1 ||
                    yt < 1 || yt >= H - 1) {
                    return false;
                }
                if (board[yt][xt] != ' ') {
                    return false;
                }
            }
            
    return true;
}

